package views

import (
	"fmt"
	"time"

	"github.com/sharelib-jp/main-service/internal/catalog"
)

templ Layout(s Site, title string, path string) {
	<!DOCTYPE html>
	<html lang="ja">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — { s.Name }</title>
			<link rel="canonical" href={ templ.SafeURL(s.Canonical(path)) }/>
			<link rel="stylesheet" href={ templ.SafeURL(Asset("style.css")) }/>
			<meta name="htmx-config" content='{"historyRestoreAsHxRequest":false,"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true}]}'/>
			<script src={ templ.SafeURL(Asset("htmx.min.js")) } defer></script>
			<script src={ templ.SafeURL(Asset("copy.js")) } defer></script>
		</head>
		<body>
			<a class="skip-link" href="#main">本文へ移動</a>
			<header class="site-header">
				<a class="site-name" href="/">{ s.Name }</a>
				<form action="/search" method="get" role="search" class="header-search">
					<label class="visually-hidden" for="site-query">蔵書を検索</label>
					<input id="site-query" type="search" name="q" placeholder="タイトル・著者・ISBN など"/>
					<button type="submit">検索</button>
				</form>
			</header>
			<main id="main">
				{ children... }
			</main>
			<footer><p>{ s.Name } の書誌・蔵書目録</p></footer>
		</body>
	</html>
}

templ Home(s Site) {
	@Layout(s, "蔵書を探す", "/") {
		<section class="home-intro">
			<p class="eyebrow">図書館の目録</p>
			<h1>次に読む一冊を、探す。</h1>
			<p>タイトル、著者、出版社、ISBN、蔵書の管理コードから検索できます。</p>
			<p><a class="button" href="/search">すべての書誌情報を見る</a></p>
		</section>
	}
}

templ Detail(label, value string) {
	if HasText(value) {
		<tr><th scope="row">{ label }</th><td>{ value }</td></tr>
	}
}

templ ReferenceTable(values map[string]any) {
	if len(References(values)) > 0 {
		<table>
			<caption class="visually-hidden">参照識別子と参照先</caption>
			<tbody>
				for _, r := range References(values) {
					<tr>
						<th scope="row">{ r.Key }</th>
						<td>
							if r.URL != "" {
								<a href={ templ.URL(r.URL) } rel="noreferrer">{ r.Text }<img class="external-icon" src={ templ.SafeURL(Asset("external.svg")) } alt="" aria-hidden="true" width="16" height="16"/><span class="visually-hidden">（外部サイト）</span></a>
							} else {
								{ r.Text }
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ CopyField(id, label, text, buttonLabel string, rows int) {
	<div class="copy-field">
		<label for={ id }>{ label }</label>
		<textarea id={ id } readonly rows={ fmt.Sprint(rows) } spellcheck="false" aria-describedby={ id + "-status" }>{ text }</textarea>
		<div class="copy-actions">
			<button type="button" hidden data-copy-target={ id } data-copy-status={ id + "-status" } data-copy-label={ label }>{ buttonLabel }</button>
			<span id={ id + "-status" } class="copy-status" role="status" aria-live="polite" aria-atomic="true"></span>
		</div>
	</div>
}

templ RecordDates(b catalog.Book, generatedAt time.Time) {
	if (b.CreatedAt != nil && !b.CreatedAt.IsZero()) || !b.UpdatedAt.IsZero() || !generatedAt.IsZero() {
		<footer class="record-footer" aria-label="書誌とページの日時">
			<dl class="record-dates">
				if b.CreatedAt != nil && !b.CreatedAt.IsZero() {
					<div><dt>書誌情報作成日時</dt><dd><time datetime={ TimestampValue(*b.CreatedAt) }>{ Timestamp(*b.CreatedAt) }</time></dd></div>
				}
				if !b.UpdatedAt.IsZero() {
					<div><dt>書誌情報最終更新日時</dt><dd><time datetime={ TimestampValue(b.UpdatedAt) }>{ Timestamp(b.UpdatedAt) }</time></dd></div>
				}
				if !generatedAt.IsZero() {
					<div><dt>このページの生成日時</dt><dd><time datetime={ TimestampValue(generatedAt) }>{ Timestamp(generatedAt) }</time></dd></div>
				}
			</dl>
		</footer>
	}
}

templ BookPage(s Site, b catalog.Book, generatedAt time.Time) {
	@Layout(s, b.Title, BookURL(b.ID)) {
		<nav aria-label="パンくず"><a href="/">目録</a><span aria-hidden="true">/ </span><span>書誌情報</span></nav>
		<article>
			<div class="book-heading">
				<div>
					<p class="eyebrow">書誌情報</p>
					<h1>
						{ b.Title }
						if HasText(b.Volume) {
							<span class="volume">{ b.Volume }</span>
						}
					</h1>
					<p class="muted identifier">書誌ID <code>{ b.ID }</code></p>
					if Other(b.Bibliography,"description") != "" {
						<section aria-label="要約"><h2>要約</h2><p class="preserve-lines">{ Other(b.Bibliography,"description") }</p></section>
					}
				</div>
				<img class="book-cover" src={ templ.SafeURL(Asset("no-image.svg")) } alt="書影はありません" width="160" height="240"/>
			</div>
			if len(Summary(b.Bibliography)) > 0 {
				<section aria-labelledby="summary-title">
					<h2 id="summary-title">資料情報</h2>
					<dl class="catalog-summary">
						for _, field := range Summary(b.Bibliography) {
							<div><dt><span>{ field.Label }</span><img class="summary-icon" src={ templ.SafeURL(Asset(field.Icon)) } alt="" aria-hidden="true" width="32" height="32"/></dt><dd>{ field.Value }</dd></div>
						}
					</dl>
				</section>
			}
			<section aria-labelledby="details-title">
				<h2 id="details-title">資料詳細</h2>
				<table>
					<caption class="visually-hidden">書誌の詳細情報</caption>
					<tbody>
						@Detail("タイトル", b.Title)
						@Detail("タイトル（ヨミ）", b.TitleTranscription)
						@Detail("巻次", b.Volume)
						if HasText(AuthorText(b.Bibliography)) {
							<tr>
								<th scope="row">著者</th>
								<td>
									if len(b.Authors) > 0 {
										<ul class="plain-list">
											for _, a := range b.Authors {
												<li>
													<a href={ templ.SafeURL(AuthorityURL("author", a.Authority.ID, 1)) }>{ a.Authority.Title }</a>
													if HasText(a.Role) {
														<span class="muted">（{ a.Role }）</span>
													}
													if HasText(a.Authority.Transcription) {
														<small class="reading">{ a.Authority.Transcription }</small>
													}
												</li>
											}
										</ul>
									} else {
										{ b.AuthorSummary }
									}
								</td>
							</tr>
						}
						@Detail("著者表示（ヨミ）", b.AuthorSummaryTranscription)
						if HasText(PublisherText(b.Bibliography)) {
							<tr>
								<th scope="row">出版社</th>
								<td>
									if b.Publisher != nil && HasText(b.Publisher.Title) {
										<a href={ templ.SafeURL(AuthorityURL("publisher", b.Publisher.ID, 1)) }>{ b.Publisher.Title }</a>
									} else {
										{ b.PublisherSummary }
									}
								</td>
							</tr>
						}
						@Detail("出版社（ヨミ）", b.PublisherSummaryTranscription)
						@Detail("出版年月日", b.FirstPublishDate)
						@Detail("分類（NDC）", b.NDC)
						@Detail("NDC の版", b.NDCEdition)
						@Detail("言語", b.Language)
						@Detail("形態", Other(b.Bibliography, "extent"))
						@Detail("価格", Other(b.Bibliography, "price"))
					</tbody>
				</table>
			</section>
			<section aria-labelledby="copies-title">
				<h2 id="copies-title">蔵書情報 <span class="count">{ fmt.Sprint(len(b.Copies)) }冊</span></h2>
				if len(b.Copies) == 0 {
					<p>この書誌には蔵書が登録されていません。</p>
				} else {
					<div class="table-scroll">
						<table>
							<caption class="visually-hidden">この書誌に紐づく蔵書</caption>
							<thead><tr><th scope="col">管理コード</th><th scope="col">状態</th><th scope="col">貸出規則</th></tr></thead>
							<tbody>
								for _, c := range b.Copies {
									<tr id={ "copy-" + c.ID }><th scope="row"><a href={ templ.SafeURL(CopyURL(c.ManagementCode)) }>{ c.ManagementCode }</a></th><td>{ Condition(c.Condition) }</td><td>{ LoanPolicy(c.LoanPolicy) }</td></tr>
								}
							</tbody>
						</table>
					</div>
					<p class="muted">貸出規則を掲載しています。現在の貸出状況は表示していません。</p>
				}
			</section>
			if len(References(b.Reference)) > 0 {
				<section aria-labelledby="references-title"><h2 id="references-title">参照情報</h2>@ReferenceTable(b.Reference)</section>
			}
			<section aria-labelledby="share-title">
				<h2 id="share-title">引用・共有</h2>
				@CopyField("citation-text", "引用文", Citation(s, b.Bibliography), "引用文をコピー", 4)
				@CopyField("page-url", "ページの URL", s.Canonical(BookURL(b.ID)), "URL をコピー", 2)
			</section>
			<section aria-labelledby="export-title"><h2 id="export-title">書誌情報の取得</h2><p><a href={ templ.SafeURL(JSONURL(b.ID)) } download={ b.ID + ".json" }>JSON 形式で取得</a></p></section>
			@RecordDates(b, generatedAt)
		</article>
	}
}

templ BookList(books []catalog.Book) {
	<ul class="book-list">
		for _, b := range books {
			<li>
				<article>
					<h3>
						<a href={ templ.SafeURL(BookURL(b.ID)) }>
							{ b.Title }
							if HasText(b.Volume) {
								<span>{ b.Volume }</span>
							}
						</a>
					</h3>
					if HasText(AuthorText(b.Bibliography)) {
						<p>{ AuthorText(b.Bibliography) }</p>
					}
					<p class="muted">{ BookMetadata(b) }</p>
				</article>
			</li>
		}
	</ul>
}

templ AuthorityPage(s Site, kind string, a catalog.Authority, books []catalog.Book, page, pages int, total int64) {
	@Layout(s, a.Title, AuthorityURL(kind, a.ID, page)) {
		<nav aria-label="パンくず">
			<a href="/">目録</a><span aria-hidden="true">/ </span>
			<span>
				if kind == "author" {
					著者目録
				} else {
					出版社目録
				}
			</span>
		</nav>
		<article>
			<p class="eyebrow">
				if kind == "author" {
					著者目録
				} else {
					出版社目録
				}
			</p>
			<h1>{ a.Title }</h1>
			if HasText(a.Transcription) {
				<p class="muted">{ a.Transcription }</p>
			}
			<p class="muted identifier">典拠ID <code>{ a.ID }</code></p>
			if len(a.AlternativeTitles)>0 || HasText(a.BirthDate) || HasText(a.FoundationDate) {
				<section>
					<h2>典拠情報</h2>
					<dl class="authority-details">
						if len(a.AlternativeTitles)>0 {
							<dt>別名</dt>
							<dd>
								<ul class="plain-list">
									for _, alias := range a.AlternativeTitles {
										<li>
											{ alias.Title }
											if HasText(alias.Transcription) {
												<small class="reading">{ alias.Transcription }</small>
											}
										</li>
									}
								</ul>
							</dd>
						}
						if HasText(a.BirthDate) {
							<dt>生年月日</dt>
							<dd>{ a.BirthDate }</dd>
						}
						if HasText(a.FoundationDate) {
							<dt>設立年月日</dt>
							<dd>{ a.FoundationDate }</dd>
						}
					</dl>
				</section>
			}
			<section>
				<h2>関連する書誌 <span class="count">{ fmt.Sprint(total) }件</span></h2>
				<p><a href={ templ.SafeURL(authoritySearch(kind, a.ID)) }>この典拠で検索・並び替え</a></p>
				if len(books)==0 {
					<p>関連する書誌情報は登録されていません。</p>
				} else {
					@BookList(books)
				}
				if pages>1 {
					<nav aria-label="目録のページ">
						<ul class="pagination">
							if page>1 {
								<li><a rel="prev" href={ templ.SafeURL(AuthorityURL(kind, a.ID, page-1)) }>前へ</a></li>
							}
							<li><span aria-current="page">{ fmt.Sprintf("%d / %d",page,pages) }</span></li>
							if page<pages {
								<li><a rel="next" href={ templ.SafeURL(AuthorityURL(kind, a.ID, page+1)) }>次へ</a></li>
							}
						</ul>
					</nav>
				}
			</section>
			if len(References(a.References)) > 0 {
				<section><h2>参照情報</h2>@ReferenceTable(a.References)</section>
			}
			<section aria-labelledby="share-title">
				<h2 id="share-title">共有</h2>
				@CopyField("page-url", "ページの URL", s.Canonical(AuthorityURL(kind, a.ID, page)), "URL をコピー", 2)
			</section>
		</article>
	}
}

func authoritySearch(kind, id string) string {
	o := catalog.SearchOptions{}
	if kind == "author" {
		o.AuthorID = id
	} else {
		o.PublisherID = id
	}
	return SearchURL(o, 1)
}

templ SearchPage(s Site, v SearchView) {
	@Layout(s, "書誌を検索", SearchURL(v.Options, v.Options.Page)) {
		<h1>書誌を検索</h1>
		<form class="search-form" action="/search" method="get" hx-get="/ajax/search" hx-target="#search-results" hx-swap="outerHTML" hx-indicator="#search-loading" hx-sync="this:replace">
			<label for="query">キーワード</label>
			<div class="search-input"><input id="query" type="search" name="q" value={ v.Options.Query } placeholder="タイトル・ヨミ・著者・出版社・ISBN・管理コード"/><button type="submit">検索</button></div>
			if v.Options.AuthorID!="" {
				<input type="hidden" name="authorId" value={ v.Options.AuthorID }/>
				<p class="filter">著者：{ v.Author } <a href={ templ.SafeURL(clearFilter(v.Options, "authorId")) }>解除</a></p>
			}
			if v.Options.PublisherID!="" {
				<input type="hidden" name="publisherId" value={ v.Options.PublisherID }/>
				<p class="filter">出版社：{ v.Publisher } <a href={ templ.SafeURL(clearFilter(v.Options, "publisherId")) }>解除</a></p>
			}
			<div class="sort-field">
				<label for="sort">並び順</label>
				<select id="sort" name="sort">
					<option value="updated" selected?={ v.Options.Sort=="updated" || v.Options.Sort=="" }>更新日が新しい順</option>
					<option value="title" selected?={ v.Options.Sort=="title" }>タイトル順</option>
					<option value="published" selected?={ v.Options.Sort=="published" }>出版日が新しい順</option>
				</select>
			</div>
			<p id="search-loading" class="htmx-indicator" role="status">検索しています…</p>
		</form>
		@SearchResults(v)
	}
}

func clearFilter(o catalog.SearchOptions, key string) string {
	if key == "authorId" {
		o.AuthorID = ""
	} else {
		o.PublisherID = ""
	}
	return SearchURL(o, 1)
}

templ SearchResults(v SearchView) {
	<section id="search-results" aria-live="polite" aria-atomic="true" tabindex="-1">
		<h2>検索結果 <span class="count">{ fmt.Sprint(v.Page.Total) }件</span></h2>
		if len(v.Page.Items)==0 {
			<p>該当する書誌情報はありません。検索語や絞り込み条件を変えてお試しください。</p>
		} else {
			@BookList(v.Page.Items)
		}
		if v.Pages()>1 {
			<nav aria-label="検索結果のページ">
				<ul class="pagination">
					if v.Page.Page>1 {
						<li><a rel="prev" href={ templ.SafeURL(SearchURL(v.Options, v.Page.Page-1)) } hx-get={ "/ajax/search?" + pageQuery(v.Options, v.Page.Page-1) } hx-target="#search-results" hx-swap="outerHTML" hx-sync="closest main:replace">前へ</a></li>
					}
					<li><span aria-current="page">{ fmt.Sprintf("%d / %d",v.Page.Page,v.Pages()) }</span></li>
					if v.Page.Page<v.Pages() {
						<li><a rel="next" href={ templ.SafeURL(SearchURL(v.Options, v.Page.Page+1)) } hx-get={ "/ajax/search?" + pageQuery(v.Options, v.Page.Page+1) } hx-target="#search-results" hx-swap="outerHTML" hx-sync="closest main:replace">次へ</a></li>
					}
				</ul>
			</nav>
		}
	</section>
}

func pageQuery(o catalog.SearchOptions, page int) string { o.Page = page; return o.Values().Encode() }

templ ErrorContent(title, message string) {
	<section id="search-results" role="alert" tabindex="-1"><h2>{ title }</h2><p>{ message }</p><p><a href="/search">検索画面へ</a></p></section>
}

templ ErrorPage(s Site, path, title, message string) {
	@Layout(s, title, path) {
		<h1>{ title }</h1>
		<p>{ message }</p>
		<p><a href="/search">検索画面へ</a></p>
	}
}
